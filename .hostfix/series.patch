+// Bare downloads are accepted only for explicitly allowlisted catalog entries.
+// Validate the executable format and target architecture before installing.
+func validateRawELF(blob []byte, arch string) error {
+	f, err := elf.NewFile(bytes.NewReader(blob))
+	if err != nil {
+		return fmt.Errorf("裸二进制不是有效 ELF: %w", err)
+	}
+	defer f.Close()
+	want := elf.EM_X86_64
+	if arch == "arm64" {
+		want = elf.EM_AARCH64
+	} else if arch != "amd64" {
+		return fmt.Errorf("不支持裸二进制架构 %q", arch)
+	}
+	if f.Class != elf.ELFCLASS64 || f.Data != elf.ELFDATA2LSB || f.Machine != want || (f.Type != elf.ET_EXEC && f.Type != elf.ET_DYN) {
+		return fmt.Errorf("ELF 格式或架构不匹配: %s/%s/%s", f.Class, f.Machine, f.Type)
+	}
+	for _, p := range f.Progs {
+		if p.Type == elf.PT_LOAD && p.Filesz > 0 && p.Off <= uint64(len(blob)) && p.Filesz <= uint64(len(blob))-p.Off {
+			return nil
+		}
+	}
+	return fmt.Errorf("ELF 缺少有效加载段")
+}
