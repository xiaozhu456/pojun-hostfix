+package selfupdate
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestHostfixVersionOrderingAndValidation(t *testing.T) {
+	ordered := []string{"0.4.38-hostfix.99", "0.4.39", "v0.4.39-hostfix.1", "0.4.39-hostfix.2", "0.4.39-hostfix.10", "0.4.40", "0.5.0-hostfix.1"}
+	for i, a := range ordered {
+		if !ValidVersionTag(a) {
+			t.Fatalf("published version rejected: %q", a)
+		}
+		for j, b := range ordered {
+			want := 0
+			if i < j {
+				want = -1
+			} else if i > j {
+				want = 1
+			}
+			if got, ok := CompareVersions(a, b); !ok || got != want {
+				t.Fatalf("CompareVersions(%q,%q)=%d,%v want %d", a, b, got, ok, want)
+			}
+		}
+	}
+	for _, v := range []string{"0.4.39-hostfix.0", "0.4.39-hostfix.01", "0.4.39-hostfix.-1", "0.4.39-hostfix.1/../../x", "0.4.39-hostfix.1\n", "0.4.39+hostfix.1", "0.4.39-dirty", "0.4.39-hostfix.9999999999999999999999999999"} {
+		if _, ok := CompareVersions(v, "0.4.39"); ok && !strings.HasSuffix(v, "\n") {
+			t.Errorf("invalid version comparable: %q", v)
+		}
+		if ValidVersionTag(v) {
+			t.Errorf("unsafe tag accepted: %q", v)
+		}
+	}
+	if got := AssetName("v0.4.39-hostfix.2", "linux", "amd64"); got != "pojun-0.4.39-hostfix.2-linux-amd64.zip" {
+		t.Fatal(got)
+	}
+}
+
+type hostfixTransport func(*http.Request) (*http.Response, error)
+
+func (f hostfixTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestHostfixChannelDoesNotFallBackToOfficial(t *testing.T) {
+	if Repo != "xiaozhu456/pojun-hostfix" {
+		t.Fatalf("wrong compiled source: %s", Repo)
+	}
+	var urls []string
+	c := &http.Client{Transport: hostfixTransport(func(r *http.Request) (*http.Response, error) {
+		urls = append(urls, r.URL.String())
+		return &http.Response{StatusCode: 404, Body: io.NopCloser(strings.NewReader(`{}`)), Header: make(http.Header)}, nil
+	})}
+	if _, err := FetchLatest(context.Background(), c); err == nil {
+		t.Fatal("missing channel must fail")
+	}
+	if _, err := FetchByTag(context.Background(), c, "0.4.39-hostfix.2"); err == nil {
+		t.Fatal("missing release must fail")
+	}
+	if len(urls) != 3 {
+		t.Fatalf("unexpected requests: %v", urls)
+	}
+	for _, u := range urls {
+		if !strings.HasPrefix(u, "https://api.github.com/repos/xiaozhu456/pojun-hostfix/releases/") {
+			t.Fatalf("escaped channel: %s", u)
+		}
+	}
+}
