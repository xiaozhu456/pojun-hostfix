+package hosttools
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+func TestFullCatalogRemainsCompactAndComplete(t *testing.T) {
+	items := Catalog()
+	for i := range items {
+		items[i].Available = true
+	}
+	text := formatSummaryText(items)
+	data, _ := json.Marshal(summarize(items))
+	if len(text) > 4000 || len(data) > 4000 {
+		t.Fatalf("full inventory too large: text=%d json=%d", len(text), len(data))
+	}
+	for _, item := range items {
+		if !strings.Contains(text, displayTool(item)) {
+			t.Errorf("missing %s", item.ID)
+		}
+	}
+}
+
+func TestStableIDsAndRealCommands(t *testing.T) {
+	for id, bin := range map[string]string{"imagemagick": "magick", "impacket": "impacket-wmiexec", "pwntools": "pwn", "netexec": "nxc"} {
+		tool, ok := Lookup(id)
+		if !ok || tool.ID != id || tool.Bin != bin {
+			t.Fatalf("%s: %+v", id, tool)
+		}
+	}
+	for _, tool := range Catalog() {
+		if tool.PipLibrary && pythonModules[tool.ID] == "" {
+			t.Errorf("missing import mapping: %s", tool.ID)
+		}
+	}
+}
+
+func TestLibraryChecksImportInsteadOfCommand(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("POSIX executable fixture")
+	}
+	dir := t.TempDir()
+	python := filepath.Join(dir, "python3")
+	if err := os.WriteFile(python, []byte("#!/bin/sh\nprintf '%s\\n' '{\"pika\":true,\"psycopg2\":false}'\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", dir)
+	t.Setenv("POJUN_TOOL_PYTHON", python)
+	InvalidateInventory()
+	defer InvalidateInventory()
+	pika, _ := Lookup("pika")
+	psycopg, _ := Lookup("psycopg2-binary")
+	if !pika.AvailableInPath() {
+		t.Fatal("importable library without CLI must be available")
+	}
+	if psycopg.AvailableInPath() {
+		t.Fatal("failed import must remain unavailable")
+	}
+}
+
+func TestSecListsChecksDataInsteadOfExecutable(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("POJUN_SECLISTS_DIR", dir)
+	tool, _ := Lookup("seclists")
+	if tool.AvailableInPath() {
+		t.Fatal("empty directory must not be available")
+	}
+	file := filepath.Join(dir, "Discovery", "Web-Content", "common.txt")
+	if err := os.MkdirAll(filepath.Dir(file), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(file, []byte("admin\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if !tool.AvailableInPath() {
+		t.Fatal("dictionary data without CLI must be available")
+	}
+}
