new file mode 100644
index 0000000..04f2716
--- /dev/null
+++ b/hosttools/probe.go
@@ -0,0 +1,136 @@
+package hosttools
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+)
+
+var pythonModules = map[string]string{
+	"gmqtt": "gmqtt", "paho-mqtt": "paho.mqtt.client", "pika": "pika",
+	"amqpstorm": "amqpstorm", "confluent-kafka": "confluent_kafka", "kombu": "kombu",
+	"pymongo": "pymongo", "pymysql": "pymysql", "psycopg2-binary": "psycopg2",
+	"redis": "redis", "zeep": "zeep", "python-gitlab": "gitlab", "netmiko": "netmiko",
+	"napalm": "napalm", "splunk-sdk": "splunklib", "impacket": "impacket",
+}
+
+// PythonExecutable is shared by inventory and the library installer so they
+// inspect the same environment. An explicit path supports a managed venv.
+func PythonExecutable() string {
+	if p := strings.TrimSpace(os.Getenv("POJUN_TOOL_PYTHON")); p != "" {
+		return p
+	}
+	return "python3"
+}
+
+var moduleCache struct {
+	sync.Mutex
+	key    string
+	at     time.Time
+	values map[string]bool
+}
+
+func InvalidateInventory() {
+	moduleCache.Lock()
+	moduleCache.at = time.Time{}
+	moduleCache.Unlock()
+}
+
+func moduleAvailable(module string) bool {
+	python := PythonExecutable()
+	key := python + "\x00" + os.Getenv("PATH") + "\x00" + os.Getenv("PYTHONPATH")
+	moduleCache.Lock()
+	defer moduleCache.Unlock()
+	if moduleCache.key == key && time.Since(moduleCache.at) < 10*time.Second {
+		return moduleCache.values[module]
+	}
+	modules := make([]string, 0, len(pythonModules))
+	for _, name := range pythonModules {
+		modules = append(modules, name)
+	}
+	args, _ := json.Marshal(modules)
+	ctx, cancel := context.WithTimeout(context.Background(), 12*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, python, "-c", `import contextlib,importlib,io,json,sys
+result={}
+for name in json.loads(sys.argv[1]):
+    try:
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+            importlib.import_module(name)
+        result[name]=True
+    except Exception:
+        result[name]=False
+print(json.dumps(result))`, string(args))
+	values := map[string]bool{}
+	if data, err := cmd.Output(); err == nil {
+		_ = json.Unmarshal(data, &values)
+	}
+	moduleCache.key, moduleCache.at, moduleCache.values = key, time.Now(), values
+	return values[module]
+}
+
+func toolAvailable(t Tool) bool {
+	if t.PipLibrary {
+		return moduleAvailable(pythonModules[t.ID])
+	}
+	if t.ID == "seclists" {
+		roots := []string{"/opt/SecLists", "/usr/share/seclists"}
+		if custom := strings.TrimSpace(os.Getenv("POJUN_SECLISTS_DIR")); custom != "" {
+			roots = []string{custom}
+		}
+		for _, root := range roots {
+			if st, err := os.Stat(filepath.Join(root, "Discovery", "Web-Content", "common.txt")); err == nil && st.Mode().IsRegular() {
+				return true
+			}
+		}
+		return false
+	}
+	if t.ID == "impacket" {
+		return commandAvailable(t.Bin) && moduleAvailable("impacket")
+	}
+	if t.ID == "imagemagick" {
+		return commandAvailable("magick") || commandAvailable("convert")
+	}
+	if t.ID == "node" {
+		return commandAvailable("node") && commandAvailable("npm") && commandAvailable("npx")
+	}
+	return commandAvailable(t.Bin)
+}
+
+func commandAvailable(name string) bool {
+	_, err := exec.LookPath(name)
+	return err == nil
+}
+
+func displayTool(t Tool) string {
+	if t.PipLibrary {
+		return "Python库 " + pythonModules[t.ID]
+	}
+	if t.ID == "seclists" {
+		return "SecLists 字典 /opt/SecLists"
+	}
+	return t.Bin
+}
+
+// Keep all catalog entries useful in prompts without exceeding the existing
+// 4 KB tool-list budget. Full descriptions remain unchanged in the UI/API.
+func compactPurpose(s string) string {
+	if i := strings.IndexAny(s, "(（"); i >= 0 {
+		s = s[:i]
+	}
+	s = strings.TrimSpace(s)
+	if len(s) <= 24 {
+		return s
+	}
+	n := 21
+	for n > 0 && !utf8.ValidString(s[:n]) {
+		n--
+	}
+	return s[:n] + "…"
+}
