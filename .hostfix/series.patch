+package hostd
+
+import (
+	"archive/tar"
+	"bytes"
+	"compress/gzip"
+	"encoding/binary"
+	"strings"
+	"testing"
+
+	"github.com/chu0119/pojun/hosttools"
+)
+
+func TestTarWithMissingBinaryIsRejected(t *testing.T) {
+	var blob bytes.Buffer
+	gz := gzip.NewWriter(&blob)
+	tw := tar.NewWriter(gz)
+	if err := tw.WriteHeader(&tar.Header{Name: "LICENSE", Mode: 0o644, Size: 4}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := tw.Write([]byte("test")); err != nil {
+		t.Fatal(err)
+	}
+	if err := tw.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := gz.Close(); err != nil {
+		t.Fatal(err)
+	}
+	tool, _ := hosttools.Lookup("ligolo-ng")
+	if tool.BinInZip != "proxy" {
+		t.Fatal("Ligolo archive member mapping is wrong")
+	}
+	if _, err := installFromArchive(&Job{}, blob.Bytes(), tool); err == nil || !strings.Contains(err.Error(), "找不到二进制") {
+		t.Fatalf("tar should be rejected before installation: %v", err)
+	}
+}
+
+func elfFixture(machine uint16) []byte {
+	b := make([]byte, 120)
+	copy(b, []byte{0x7f, 'E', 'L', 'F', 2, 1, 1})
+	binary.LittleEndian.PutUint16(b[16:], 2)
+	binary.LittleEndian.PutUint16(b[18:], machine)
+	binary.LittleEndian.PutUint32(b[20:], 1)
+	binary.LittleEndian.PutUint64(b[32:], 64)
+	binary.LittleEndian.PutUint16(b[52:], 64)
+	binary.LittleEndian.PutUint16(b[54:], 56)
+	binary.LittleEndian.PutUint16(b[56:], 1)
+	binary.LittleEndian.PutUint32(b[64:], 1)
+	binary.LittleEndian.PutUint64(b[96:], 120)
+	return b
+}
+
+func TestValidateBareELFArchitectureAndContent(t *testing.T) {
+	if err := validateRawELF(elfFixture(62), "amd64"); err != nil {
+		t.Fatal(err)
+	}
+	if err := validateRawELF(elfFixture(183), "amd64"); err == nil {
+		t.Fatal("wrong architecture accepted")
+	}
+	if err := validateRawELF([]byte("<html>download error</html>"), "amd64"); err == nil {
+		t.Fatal("HTML accepted")
+	}
+	if err := validateRawELF(elfFixture(62)[:70], "amd64"); err == nil {
+		t.Fatal("truncated ELF accepted")
+	}
+	for _, id := range []string{"pspy64", "linpeas"} {
+		tool, ok := hosttools.Lookup(id)
+		if !ok || !tool.RawBinary {
+			t.Fatalf("raw tool not declared: %s", id)
+		}
+	}
+	tool, _ := hosttools.Lookup("nuclei")
+	if tool.RawBinary {
+		t.Fatal("archive tool must not accept bare downloads")
+	}
+}
+
+func TestLibraryInstallUsesConfiguredVenv(t *testing.T) {
+	t.Setenv("POJUN_TOOL_PYTHON", "/opt/pojun-tools/python/bin/python3")
+	tool, _ := hosttools.Lookup("pika")
+	args := pipArgv(tool, "")
+	if args[0] != "/opt/pojun-tools/python/bin/python3" {
+		t.Fatal(args)
+	}
+	for _, a := range args {
+		if a == "--break-system-packages" {
+			t.Fatal("managed venv must not override system-package protections")
+		}
+	}
+}
